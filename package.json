{
	"name": "email-mcp-server",
	"version": "1.0.0",
	"private": true,
	"description": "A Cloudflare Workers MCP server for Gmail, Outlook, iCloud, Yahoo, and custom IMAP/SMTP accounts.",
	"keywords": [
		"cloudflare-workers",
		"email",
		"imap",
		"mcp",
		"model-context-protocol",
		"smtp"
	],
	"homepage": "https://github.com/Xzese/email-mcp-server#readme",
	"bugs": {
		"url": "https://github.com/Xzese/email-mcp-server/issues"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Xzese/email-mcp-server.git"
	},
	"type": "module",
	"scripts": {
		"deploy": "node scripts/deploy.mjs",
		"upload": "wrangler versions upload",
		"cloudflare:deploy": "node scripts/deploy.mjs",
		"cloudflare:upload": "wrangler versions upload",
		"dev": "wrangler dev",
		"start": "wrangler dev",
		"format": "oxfmt --write .",
		"format:check": "oxfmt --check .",
		"lint": "oxlint .",
		"lint:fix": "oxlint --fix",
		"test": "npm run type-check && node --test tests/*.test.ts",
		"cf-typegen": "wrangler types --env-file .dev.vars.example --strict-vars=false",
		"cf-typegen:check": "wrangler types --env-file .dev.vars.example --strict-vars=false --check",
		"public-config:check": "node scripts/check-public-config.mjs",
		"type-check": "tsc --noEmit"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.32.2",
		"agents": "^0.30.1",
		"hono": "^4.13.13",
		"jose": "^6.2.13",
		"mailparser": "^3.12.4",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@types/mailparser": "^3.9.0",
		"oxfmt": "^0.74.0",
		"oxlint": "^1.89.0",
		"typescript": "7.0.2",
		"wrangler": "^4.152.0"
	},
	"overrides": {
		"body-parser": "2.3.0",
		"brace-expansion": "5.0.8",
		"fast-uri": "3.1.4"
	},
	"engines": {
		"node": ">=22.18.0"
	}
}
